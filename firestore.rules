rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // public site content: anyone may read, only the admin may write
    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /postImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vlogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteText/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // comments: anyone may submit (unapproved only), admin moderates
    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['postId', 'name', 'text', 'date', 'approved'])
        && request.resource.data.approved == false
        && request.resource.data.postId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 1500;
      allow update, delete: if isAdmin();
    }

    // view counters: anyone may increment by exactly 1
    match /postStats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if isAdmin();
    }

    // everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'marek.pinka@gmail.com';
    }
  }
}
